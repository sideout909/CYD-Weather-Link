[Unit]
Description=Continuous AcuRite Atlas reference packet capture

[Service]
Type=simple
WorkingDirectory=%h/Documents/CYD Weather Link
ExecStart=/usr/bin/python "%h/Documents/CYD Weather Link/tools/atlas_capture.py" --output "%h/Documents/CYD Weather Link/captures/atlas"
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
KillMode=mixed
TimeoutStopSec=10
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
